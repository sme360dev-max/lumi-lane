# Local development: omit DATABASE_URL to use backend/db.sqlite3
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=local-development-only-change-this
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Allowed website origins. Add the Cloudflare Pages production domain on Render.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CSRF_TRUSTED_ORIGINS=

# Production only: Supabase Postgres connection string. Use the Supabase session pooler.
# DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@HOST:5432/postgres
DB_SSLMODE=require

# Brevo transactional email API. Use a verified sender address in DEFAULT_FROM_EMAIL.
BREVO_API_KEY=
DEFAULT_FROM_EMAIL=Lumi Lane <no-reply@example.com>
BOOKING_NOTIFICATION_EMAIL=

# Public Render URL, used in booking notifications
PUBLIC_BACKEND_URL=http://127.0.0.1:8000
